{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:weewx:extension-repository:1",
  "title": "WeeWX extension repository version 1",
  "description": "Structural contract. Clients also validate versions, requirements, URL policy, uniqueness, and archive digests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "packages"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "not": {
            "pattern": "[^A-Za-z0-9_.-]"
          }
        },
        "name": {
          "$ref": "#/definitions/label"
        },
        "description": {
          "$ref": "#/definitions/description"
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/package"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "definitions": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "not": {
        "pattern": "[^a-z0-9-]"
      }
    },
    "installer_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*$",
      "not": {
        "pattern": "[^A-Za-z0-9_.-]"
      }
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "specifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "format": "uri-reference",
      "not": {
        "pattern": "[\u0000- \u007f]"
      }
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "installer_name",
        "name",
        "description",
        "types",
        "category",
        "releases"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/slug"
        },
        "installer_name": {
          "$ref": "#/definitions/installer_name"
        },
        "name": {
          "$ref": "#/definitions/label"
        },
        "description": {
          "$ref": "#/definitions/description"
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "skin",
              "driver",
              "service",
              "search-list",
              "generator",
              "other"
            ]
          }
        },
        "category": {
          "description": "Purpose of the package, used for listings and search.",
          "enum": [
            "skin",
            "driver",
            "uploader",
            "forecast",
            "other"
          ]
        },
        "keywords": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "homepage": {
          "$ref": "#/definitions/url"
        },
        "releases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/release"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "requires_python",
        "requires_weewx",
        "archive"
      ],
      "properties": {
        "version": {
          "$ref": "#/definitions/version"
        },
        "requires_python": {
          "$ref": "#/definitions/specifier"
        },
        "requires_weewx": {
          "$ref": "#/definitions/specifier"
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "format",
            "sha256"
          ],
          "properties": {
            "url": {
              "$ref": "#/definitions/url"
            },
            "format": {
              "enum": [
                "zip",
                "tar",
                "tar.gz",
                "tar.bz2",
                "tar.xz"
              ]
            },
            "sha256": {
              "$ref": "#/definitions/sha256"
            }
          }
        },
        "release_notes": {
          "$ref": "#/definitions/url"
        },
        "restart_required": {
          "type": "boolean",
          "default": true
        },
        "yanked": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
