+def _update_archive_schema():
+    columns = {
+        "sqm": "REAL",
+        "sqmTemp": "REAL",
+        "sqmTime": "REAL",
+        "nelm": "REAL",
+        "cdm2": "REAL",
+        "nsu": "REAL",
+        "solarAlt": "REAL",
+        "lunarAlt": "REAL",
+        "lunarPhase": "REAL",
+    }
+
+    config = _load_config()
+    db_type, db_cfg, table, config = _get_db_info(config)
+
+    if db_type.lower() == "sqlite":
+        sqlite_root = config["DatabaseTypes"]["SQLite"]["SQLITE_ROOT"]
+        db_path = os.path.join(sqlite_root, db_cfg["database_name"])
+        _ensure_sqlite_columns(db_path, table, columns)
+        return
+
+    if db_type.lower() == "mysql":
+        _ensure_mysql_columns(db_cfg, table, columns)
+        return
+
+    raise SystemExit(f"Aborting install: unsupported database_type '{db_type}'")
