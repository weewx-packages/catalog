+
+    row_old = (
+        "                    $row.windchill.raw,\n"
+        "                    $row.barometer.raw\n"
+        "                ]\n"
+    )
+    row_new = (
+        "                    $row.windchill.raw,\n"
+        "                    $row.barometer.raw,\n"
+        "                    $row.sqm.raw,\n"
+        "                    $row.sqmTemp.raw,\n"
+        "                    $row.sqmTime.raw,\n"
+        "                    $row.nelm.raw,\n"
+        "                    $row.cdm2.raw,\n"
+        "                    $row.nsu.raw,\n"
+        "                    $row.solarAlt.raw,\n"
+        "                    $row.lunarAlt.raw,\n"
+        "                    $row.lunarPhase.raw\n"
+        "                ]\n"
+    )
+    _replace_once(dataset_path, row_old, row_new, "daily_captures rows")
+    _insert_after(
+        dataset_path,
+        "                \"sqmTemp\",\n",
+        "                \"sqmTime\",\n",
+        "daily_captures fields sqmTime",
+    )
+    _insert_after(
+        dataset_path,
+        "                    $row.sqmTemp.raw,\n",
+        "                    $row.sqmTime.raw,\n",
+        "daily_captures rows sqmTime",
+    )
+
