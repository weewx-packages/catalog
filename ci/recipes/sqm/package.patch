+import math
+import time
+from dataclasses import dataclass
+from typing import Optional
+
+
+@dataclass(frozen=True)
+class SQMSample:
+    sqm: float
+    temp_c: Optional[float]
+    timestamp: float
+    lunar_alt_deg: Optional[float] = None
+    lunar_phase: Optional[float] = None
+    solar_alt_deg: Optional[float] = None
+
+    @property
+    def valid(self) -> bool:
+        return self.sqm > 0.0
+
+    @property
+    def cdm2(self) -> float:
+        # 108000 * 10^(-0.4 * sqm)
+        return 108000.0 * (10 ** (-0.4 * self.sqm))
+
+    @property
+    def nsu(self) -> float:
+        # 10^(0.4 * (21.6 - sqm))
+        return 10 ** (0.4 * (21.6 - self.sqm))
+
+    @property
+    def nelm(self) -> float:
+        # 7.93 - 5 * log10(10^(4.316 - sqm/5) + 1)
+        return 7.93 - 5.0 * math.log10((10 ** (4.316 - (self.sqm / 5.0))) + 1.0)
+
+
+class SQMParseError(ValueError):
+    pass
+
+
+def _parse_float_token(token: str, suffix: str) -> float:
+    if not token.endswith(suffix):
+        raise SQMParseError(f"Expected suffix '{suffix}' in token '{token}'")
+    try:
+        return float(token[:-len(suffix)])
+    except ValueError as exc:
+        raise SQMParseError(f"Invalid float token '{token}'") from exc
+
+
+def parse_sqm_response(response: str, timestamp: Optional[float] = None) -> SQMSample:
+    """
+    Parse the SQM-LE response.
+
+    Expected format:
+        r,00.00m,0000573478Hz,0000000000c,0000000.000s,031.9C
+    """
+    parts = response.strip().split(',')
+    if len(parts) < 2:
+        raise SQMParseError(f"Unexpected response '{response}'")
+    if not parts[0].startswith('r'):
+        raise SQMParseError(f"Unexpected prefix '{parts[0]}'")
+
+    sqm = _parse_float_token(parts[1], 'm')
+    temp_c = None
+    if len(parts) >= 6:
+        try:
+            temp_c = _parse_float_token(parts[5], 'C')
+        except SQMParseError:
+            temp_c = None
+
+    if timestamp is None:
+        timestamp = time.time()
+
+    return SQMSample(sqm=sqm, temp_c=temp_c, timestamp=timestamp)
+
+
+def median(values):
+    values = sorted(values)
+    if not values:
+        return None
+    mid = len(values) // 2
+    if len(values) % 2 == 1:
+        return values[mid]
+    return (values[mid - 1] + values[mid]) / 2.0
