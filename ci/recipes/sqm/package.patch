+from weewx_sqm_le.sqm import parse_sqm_response, SQMSample
+
+
+def test_parse_response():
+    sample = parse_sqm_response(
+        "r,21.55m,0000573478Hz,0000000000c,0000000.000s,031.9C"
+    )
+    assert isinstance(sample, SQMSample)
+    assert sample.sqm == 21.55
+    assert sample.temp_c == 31.9
+    assert isinstance(sample.timestamp, float)
+
+
+def test_derived_metrics():
+    sample = SQMSample(sqm=21.6, temp_c=None, timestamp=1700000000.0)
+    # basic sanity checks
+    assert sample.cdm2 > 0
+    assert sample.nsu > 0
+    assert 0 < sample.nelm < 10
