+import argparse
+import os
+import shutil
+import tarfile
+
+VERSION = "0.1.0"
+DIST_PATH = "dist"
+
+
+def package_dir(version: str) -> str:
+    return f"weewx-sqm-le_{version}"
+
+
+def clean_dist():
+    if os.path.exists(DIST_PATH):
+        shutil.rmtree(DIST_PATH)
+    os.mkdir(DIST_PATH)
+
+
+def copy_tree(src: str, dst: str):
+    if os.path.exists(dst):
+        shutil.rmtree(dst)
+    shutil.copytree(src, dst)
+
+
+def copy_files(version: str):
+    pkg_root = os.path.join(DIST_PATH, package_dir(version))
+
+    # Python modules
+    copy_tree("src/weewx_sqm_le", os.path.join(pkg_root, "bin", "weewx_sqm_le"))
+    os.makedirs(os.path.join(pkg_root, "bin", "user"), exist_ok=True)
+    shutil.copy2("src/user/sqmle.py", os.path.join(pkg_root, "bin", "user", "sqmle.py"))
+
+    # Docs and license
+    shutil.copy2("README.md", os.path.join(pkg_root, "readme.txt"))
+    if os.path.exists("LICENSE"):
+        shutil.copy2("LICENSE", os.path.join(pkg_root, "LICENSE"))
+
+
+def file_paths(version: str):
+    pkg_root = os.path.join(DIST_PATH, package_dir(version))
+    paths = []
+
+    def walk_paths(root):
+        for dirpath, _, filenames in os.walk(root):
+            for filename in filenames:
+                rel = os.path.relpath(os.path.join(dirpath, filename), pkg_root)
+                paths.append(rel)
+
+    walk_paths(os.path.join(pkg_root, "bin", "weewx_sqm_le"))
+    walk_paths(os.path.join(pkg_root, "bin", "user"))
+
+    return (
+        "bin",
+        paths,
+    )
+
+
+def install_file(version: str):
+    with open("dist-template/install.py.template", "r") as input_file:
+        output_string = input_file.read()
+
+    output_string = output_string.replace("__VERSION__", version)
+    output_string = output_string.replace("__FILE_PATHS__", file_paths(version).__repr__())
+
+    output_path = os.path.join(DIST_PATH, package_dir(version), "install.py")
+    with open(output_path, "w") as output_file:
+        output_file.write(output_string)
+
+
+def create_zip(version: str):
+    archive_path = os.path.join(DIST_PATH, package_dir(version) + ".tar.gz")
+    with tarfile.open(archive_path, "w:gz") as archive:
+        archive.add(
+            os.path.join(DIST_PATH, package_dir(version)), arcname=package_dir(version)
+        )
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description="Package the SQM-LE extension")
+    parser.add_argument("--set-version", default=VERSION, help="Version number to build")
+
+    args = parser.parse_args()
+    version = args.set_version
+
+    clean_dist()
+    copy_files(version)
+    install_file(version)
+    create_zip(version)
