+import os
+import socket
+import sys
+
+from setup import ExtensionInstaller
+
+
+def loader():
+    return SQM_Installer()
+
+
+def _prompt(text, default):
+    try:
+        value = input(f"{text} [{default}]: ").strip()
+    except EOFError:
+        return default
+    return value or default
+
+
+def _prompt_int(text, default):
+    while True:
+        value = _prompt(text, str(default))
+        try:
+            return int(value)
+        except ValueError:
+            print("Please enter a valid integer.")
+
+
+def _test_connection(host, port, timeout):
+    try:
+        with socket.create_connection((host, port), timeout=timeout) as sock:
+            sock.sendall(b"rx")
+            data = sock.recv(1024)
+        if data:
+            print("SQM-LE response:", data.decode("utf-8", errors="replace").strip())
+        else:
+            print("No data received from SQM-LE.")
+        return True
+    except Exception as exc:
+        print("SQM-LE connection test failed:", exc)
+        return False
+
+
+def _require_skyfield(ephemeris):
+    try:
+        cache_dir = "/var/lib/weewx/skyfield"
+        os.makedirs(cache_dir, exist_ok=True)
+        cwd = os.getcwd()
+        try:
+            os.chdir(cache_dir)
+            from skyfield.api import Loader
+        finally:
+            os.chdir(cwd)
+        load = Loader(cache_dir)
+        load(ephemeris)
+        return True
+    except Exception as exc:
+        print("Skyfield test failed:", exc)
+        return False
+
+
+def _get_existing_sqm_config(config):
+    sqm_cfg = config.get("SQM-LE", {})
+    host = sqm_cfg.get("host")
+    port = sqm_cfg.get("port")
+    poll_interval = sqm_cfg.get("poll_interval")
+    socket_timeout = sqm_cfg.get("socket_timeout")
+    max_samples = sqm_cfg.get("max_samples")
+    max_sample_age = sqm_cfg.get("max_sample_age")
+    ephemeris = sqm_cfg.get("ephemeris")
+    solar_alt_max = sqm_cfg.get("solar_alt_max")
+    return host, port, poll_interval, socket_timeout, max_samples, max_sample_age, ephemeris, solar_alt_max
+
+
+def _merge_data_services(config, service_name):
+    try:
+        services = config.get("Engine", {}).get("Services", {})
+        existing = services.get("data_services", "")
+    except Exception:
+        existing = ""
+
+    parts = [p.strip() for p in str(existing).split(",") if p.strip()]
+    if service_name not in parts:
+        parts.append(service_name)
+    return ", ".join(parts)
+
+
+def _load_config():
+    try:
+        from configobj import ConfigObj
+    except Exception as exc:
+        raise SystemExit(f"Aborting install: cannot load configobj: {exc}")
+
+    conf_path = "/etc/weewx/weewx.conf"
+    if not os.path.exists(conf_path):
+        raise SystemExit(f"Aborting install: missing config {conf_path}")
+    return ConfigObj(conf_path)
+
+
+def _get_db_info(config):
+    try:
+        binding = config["DataBindings"]["wx_binding"]
+        db_name = binding["database"]
+        table = binding.get("table_name", "archive")
+        db_cfg = config["Databases"][db_name]
+        db_type = db_cfg["database_type"]
+    except Exception as exc:
+        raise SystemExit(f"Aborting install: cannot read DB settings: {exc}")
+
+    return db_type, db_cfg, table, config
+
+
+def _ensure_sqlite_columns(db_path, table, columns):
+    import sqlite3
+
+    if not os.path.exists(db_path):
+        raise SystemExit(f"Aborting install: SQLite DB not found: {db_path}")
+
+    conn = sqlite3.connect(db_path)
+    try:
+        cur = conn.cursor()
+        cur.execute(f"PRAGMA table_info({table})")
+        existing = {row[1] for row in cur.fetchall()}
+        for name, decl in columns.items():
+            if name in existing:
+                continue
+            cur.execute(f"ALTER TABLE {table} ADD COLUMN {name} {decl}")
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def _ensure_mysql_columns(db_cfg, table, columns):
+    driver = None
+    try:
+        import MySQLdb as driver  # type: ignore
+    except Exception:
+        try:
+            import pymysql as driver  # type: ignore
+        except Exception:
+            driver = None
+
+    if driver is None:
+        raise SystemExit("Aborting install: MySQL driver not available (install mysqlclient or pymysql).")
+
+    host = db_cfg.get("host", "localhost")
+    user = db_cfg.get("user")
+    password = db_cfg.get("password", "")
+    database = db_cfg.get("database_name")
+    if not user or not database:
+        raise SystemExit("Aborting install: MySQL config missing user or database_name.")
+
+    conn = driver.connect(host=host, user=user, passwd=password, db=database)
+    try:
+        cur = conn.cursor()
+        cur.execute(f"SHOW COLUMNS FROM {table}")
+        existing = {row[0] for row in cur.fetchall()}
+        for name, decl in columns.items():
+            if name in existing:
+                continue
+            cur.execute(f"ALTER TABLE {table} ADD COLUMN {name} {decl}")
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def _update_archive_schema():
+    columns = {
+        "sqm": "REAL",
+        "sqmTemp": "REAL",
+        "sqmTime": "REAL",
+        "nelm": "REAL",
+        "cdm2": "REAL",
+        "nsu": "REAL",
+        "solarAlt": "REAL",
+        "lunarAlt": "REAL",
+        "lunarPhase": "REAL",
+    }
+
+    config = _load_config()
+    db_type, db_cfg, table, config = _get_db_info(config)
+
+    if db_type.lower() == "sqlite":
+        sqlite_root = config["DatabaseTypes"]["SQLite"]["SQLITE_ROOT"]
+        db_path = os.path.join(sqlite_root, db_cfg["database_name"])
+        _ensure_sqlite_columns(db_path, table, columns)
+        return
+
+    if db_type.lower() == "mysql":
+        _ensure_mysql_columns(db_cfg, table, columns)
+        return
+
+    raise SystemExit(f"Aborting install: unsupported database_type '{db_type}'")
+
+
+def _ensure_skyfield_cache_dir():
+    cache_dir = "/var/lib/weewx/skyfield"
+    os.makedirs(cache_dir, exist_ok=True)
+    try:
+        import pwd
+        import grp
+
+        uid = pwd.getpwnam("weewx").pw_uid
+        gid = grp.getgrnam("weewx").gr_gid
+        os.chown(cache_dir, uid, gid)
+    except Exception:
+        pass
+
+
+def _inject_block(path, block, anchor):
+    try:
+        with open(path, "r") as f:
+            content = f.read()
+    except FileNotFoundError:
+        print(f"Skin template not found: {path}")
+        return False
+
+    if "\"sqmTime\"" in content:
+        print(f"SQM fields already present in: {path}")
+        return True
+
+    idx = content.find(anchor)
+    if idx == -1:
+        print(f"Anchor not found in template: {path}")
+        return False
+
+    new_content = content[:idx] + block + content[idx:]
+    with open(path, "w") as f:
+        f.write(new_content)
+    print(f"Updated template: {path}")
+    return True
+
+
+def _replace_once(path, old, new, label):
+    try:
+        with open(path, "r") as f:
+            content = f.read()
+    except FileNotFoundError:
+        print(f"Skin template not found: {path}")
+        return False
+
+    if old not in content:
+        print(f"Pattern not found for {label} in: {path}")
+        return False
+
+    content = content.replace(old, new, 1)
+    with open(path, "w") as f:
+        f.write(content)
+    print(f"Updated {label}: {path}")
+    return True
+
+
+def _insert_after(path, needle, insertion, label):
+    try:
+        with open(path, "r") as f:
+            content = f.read()
+    except FileNotFoundError:
+        print(f"Skin template not found: {path}")
+        return False
+
+    if insertion in content:
+        print(f"{label} already present in: {path}")
+        return True
+
+    idx = content.find(needle)
+    if idx == -1:
+        print(f"Pattern not found for {label} in: {path}")
+        return False
+
+    idx_end = idx + len(needle)
+    content = content[:idx_end] + insertion + content[idx_end:]
+    with open(path, "w") as f:
+        f.write(content)
+    print(f"Updated {label}: {path}")
+    return True
+
+
+def _update_skins():
+    skin_root = "/etc/weewx/skins/Conditions"
+    block = (
+        "        #if $current.sqm.has_data\n"
+        "        \"sqm\": {\"value\": $current.sqm.raw},\n"
+        "        #end if\n"
+        "        #if $current.sqmTemp.has_data\n"
+        "        \"sqmTemp\": {\"value\": $current.sqmTemp.raw},\n"
+        "        #end if\n"
+        "        #if $current.sqmTime.has_data\n"
+        "        \"sqmTime\": {\"value\": $current.sqmTime.raw},\n"
+        "        #end if\n"
+        "        #if $current.nelm.has_data\n"
+        "        \"nelm\": {\"value\": $current.nelm.raw},\n"
+        "        #end if\n"
+        "        #if $current.cdm2.has_data\n"
+        "        \"cdm2\": {\"value\": $current.cdm2.raw},\n"
+        "        #end if\n"
+        "        #if $current.nsu.has_data\n"
+        "        \"nsu\": {\"value\": $current.nsu.raw},\n"
+        "        #end if\n"
+        "        #if $current.solarAlt.has_data\n"
+        "        \"solarAlt\": {\"value\": $current.solarAlt.raw},\n"
+        "        #end if\n"
+        "        #if $current.lunarAlt.has_data\n"
+        "        \"lunarAlt\": {\"value\": $current.lunarAlt.raw},\n"
+        "        #end if\n"
+        "        #if $current.lunarPhase.has_data\n"
+        "        \"lunarPhase\": {\"value\": $current.lunarPhase.raw},\n"
+        "        #end if\n"
+    )
+    block_deep = block.replace("        ", "            ")
+
+    templates = [
+        (os.path.join(skin_root, "conditions_current.json.tmpl"), "        \"void_end\": null\n"),
+        (os.path.join(skin_root, "conditions_summary.json.tmpl"), "        \"void_end\": null\n"),
