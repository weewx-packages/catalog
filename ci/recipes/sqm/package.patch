+import os
+import socket
+import threading
+import time
+from datetime import datetime, timezone
+from typing import Optional, Tuple
+
+from .sqm import SQMSample, parse_sqm_response, median
+
+try:
+    import weewx
+    from weewx.engine import StdService
+except Exception:  # pragma: no cover - only used when WeeWX not installed
+    weewx = None
+
+    class StdService:  # type: ignore
+        def __init__(self, *args, **kwargs):
+            raise RuntimeError("WeeWX not available in this environment")
+
+
+class SkyfieldCalculator:
+    def __init__(
+        self,
+        latitude: float,
+        longitude: float,
+        altitude_m: Optional[float],
+        ephemeris: str,
+        cache_dir: str,
+    ):
+        os.makedirs(cache_dir, exist_ok=True)
+        cwd = os.getcwd()
+        try:
+            os.chdir(cache_dir)
+            from skyfield.api import Loader, wgs84
+            from skyfield import almanac
+        finally:
+            os.chdir(cwd)
+
+        self._load = Loader(cache_dir)
+        self._almanac = almanac
+        self._ts = self._load.timescale()
+        self._ephem = self._load(ephemeris)
+        self._earth = self._ephem["earth"]
+        self._sun = self._ephem["sun"]
+        self._moon = self._ephem["moon"]
+        if altitude_m is None:
+            self._location = wgs84.latlon(latitude, longitude)
+        else:
+            self._location = wgs84.latlon(latitude, longitude, elevation_m=altitude_m)
+
+    def compute(self, timestamp: float) -> Tuple[float, float, float]:
+        t = self._ts.from_datetime(datetime.fromtimestamp(timestamp, tz=timezone.utc))
+        observer = (self._earth + self._location).at(t)
+
+        moon_alt, _, _ = observer.observe(self._moon).apparent().altaz()
+        sun_alt, _, _ = observer.observe(self._sun).apparent().altaz()
+        lunar_phase = self._almanac.fraction_illuminated(self._ephem, "moon", t)
+
+        return moon_alt.degrees, lunar_phase, sun_alt.degrees
+
+
+class SQMReader:
+    def __init__(
+        self,
+        host: str,
+        port: int,
+        poll_interval: float,
+        socket_timeout: float,
+        max_samples: int,
+        skyfield: Optional[SkyfieldCalculator],
+        solar_alt_max: Optional[float],
+    ):
+        self.host = host
+        self.port = port
+        self.poll_interval = poll_interval
+        self.socket_timeout = socket_timeout
+        self.max_samples = max_samples
+        self.skyfield = skyfield
+        self.solar_alt_max = solar_alt_max
+        self._lock = threading.Lock()
+        self._latest: Optional[SQMSample] = None
+        self._samples = []
+        self._stop = threading.Event()
+        self._thread = threading.Thread(target=self._run, name="SQMReader", daemon=True)
+
+    def start(self):
+        self._thread.start()
+
+    def stop(self):
+        self._stop.set()
+        self._thread.join(timeout=self.poll_interval + 1)
+
+    def latest(self) -> Optional[SQMSample]:
+        with self._lock:
+            return self._latest
+
+    def pop_samples(self):
+        with self._lock:
+            samples = self._samples
+            self._samples = []
+            return samples
+
+    def _record(self, sample: SQMSample):
+        if not sample.valid:
+            return
+        with self._lock:
+            self._latest = sample
+            self._samples.append(sample)
+            if len(self._samples) > self.max_samples:
+                self._samples = self._samples[-self.max_samples:]
+
+    def _poll_once(self) -> Optional[SQMSample]:
+        with socket.create_connection((self.host, self.port), timeout=self.socket_timeout) as sock:
+            sock.sendall(b"rx")
+            data = sock.recv(1024)
+        if not data:
+            return None
+        response = data.decode("utf-8", errors="replace")
+        timestamp = time.time()
+        sample = parse_sqm_response(response, timestamp=timestamp)
+
+        if self.skyfield is not None:
+            try:
+                moon_alt, lunar_phase, sun_alt = self.skyfield.compute(timestamp)
+                sample = SQMSample(
+                    sqm=sample.sqm,
+                    temp_c=sample.temp_c,
+                    timestamp=sample.timestamp,
+                    lunar_alt_deg=moon_alt,
+                    lunar_phase=lunar_phase,
+                    solar_alt_deg=sun_alt,
+                )
+            except Exception:
+                # Skyfield errors should not block SQM reads
+                pass
+
+        if self.solar_alt_max is not None and sample.solar_alt_deg is not None:
+            if sample.solar_alt_deg > self.solar_alt_max:
+                return None
+
+        return sample
+
+    def _run(self):
+        while not self._stop.is_set():
+            try:
+                if self.skyfield is not None and self.solar_alt_max is not None:
+                    try:
+                        _, _, sun_alt = self.skyfield.compute(time.time())
+                        if sun_alt > self.solar_alt_max:
+                            # Skip polling SQM during daylight
+                            self._stop.wait(self.poll_interval)
+                            continue
+                    except Exception:
+                        pass
+
+                sample = self._poll_once()
+                if sample is not None:
+                    self._record(sample)
+            except Exception:
+                # Avoid crashing the thread; transient errors are expected
+                pass
+            self._stop.wait(self.poll_interval)
+
+
+class SQMService(StdService):
+    def __init__(self, engine, config_dict):
+        super().__init__(engine, config_dict)
+
+        cfg = config_dict.get("SQM-LE", {})
+        self.host = cfg.get("host", "127.0.0.1")
+        self.port = int(cfg.get("port", 10001))
+        self.poll_interval = float(cfg.get("poll_interval", 10))
+        self.socket_timeout = float(cfg.get("socket_timeout", 2.0))
+        self.max_samples = int(cfg.get("max_samples", 300))
+        self.max_sample_age = cfg.get("max_sample_age")
+        if self.max_sample_age is None:
+            self.max_sample_age = self.poll_interval * 3
+        else:
+            try:
+                self.max_sample_age = float(self.max_sample_age)
+            except ValueError:
+                self.max_sample_age = self.poll_interval * 3
+        self.solar_alt_max = cfg.get("solar_alt_max")
+        if self.solar_alt_max is not None:
+            try:
+                self.solar_alt_max = float(self.solar_alt_max)
+            except ValueError:
+                self.solar_alt_max = None
+
+        ephemeris = cfg.get("ephemeris", "de421.bsp")
+        skyfield_cache = cfg.get("skyfield_cache", "/var/lib/weewx/skyfield")
+        skyfield = self._init_skyfield(engine, config_dict, ephemeris, skyfield_cache)
+
+        self.reader = SQMReader(
+            host=self.host,
+            port=self.port,
+            poll_interval=self.poll_interval,
+            socket_timeout=self.socket_timeout,
+            max_samples=self.max_samples,
+            skyfield=skyfield,
+            solar_alt_max=self.solar_alt_max,
+        )
+        self.reader.start()
+
+        self.bind(weewx.NEW_LOOP_PACKET, self.new_loop_packet)
+        self.bind(weewx.NEW_ARCHIVE_RECORD, self.new_archive_record)
+
+    def shutDown(self):
+        self.reader.stop()
+        super().shutDown()
+
+    def _augment_packet(self, packet, sample: SQMSample):
+        packet["sqm"] = sample.sqm
+        if sample.temp_c is not None:
+            packet["sqmTemp"] = sample.temp_c
+        packet["sqmTime"] = sample.timestamp
+        packet["cdm2"] = sample.cdm2
+        packet["nsu"] = sample.nsu
+        packet["nelm"] = sample.nelm
+        if sample.lunar_alt_deg is not None:
+            packet["lunarAlt"] = sample.lunar_alt_deg
+        if sample.lunar_phase is not None:
+            packet["lunarPhase"] = sample.lunar_phase
+        if sample.solar_alt_deg is not None:
+            packet["solarAlt"] = sample.solar_alt_deg
+
+    def new_loop_packet(self, event):
+        sample = self.reader.latest()
+        if not sample:
+            return
+        event.packet["sqmTime"] = sample.timestamp
+        if not sample.valid:
+            return
+        if time.time() - sample.timestamp > self.max_sample_age:
+            return
+        self._augment_packet(event.packet, sample)
+
+    def new_archive_record(self, event):
+        samples = self.reader.pop_samples()
+        if not samples:
+            return
+        sqms = [s.sqm for s in samples if s.valid]
+        temps = [s.temp_c for s in samples if s.valid and s.temp_c is not None]
+        lunar_alts = [s.lunar_alt_deg for s in samples if s.lunar_alt_deg is not None]
+        lunar_phases = [s.lunar_phase for s in samples if s.lunar_phase is not None]
+        solar_alts = [s.solar_alt_deg for s in samples if s.solar_alt_deg is not None]
+        timestamps = [s.timestamp for s in samples if s.valid]
+        if not sqms:
+            return
+        sqm_med = median(sqms)
+        if sqm_med is None:
+            return
+        temp_med = median(temps) if temps else None
+        last_timestamp = max(timestamps) if timestamps else time.time()
+        sample = SQMSample(
+            sqm=sqm_med,
+            temp_c=temp_med,
+            timestamp=last_timestamp,
+            lunar_alt_deg=median(lunar_alts) if lunar_alts else None,
+            lunar_phase=median(lunar_phases) if lunar_phases else None,
+            solar_alt_deg=median(solar_alts) if solar_alts else None,
+        )
+        self._augment_packet(event.record, sample)
+
+    @staticmethod
+    def _init_skyfield(
+        engine, config_dict, ephemeris: str, cache_dir: str
+    ) -> Optional[SkyfieldCalculator]:
+        latitude = None
+        longitude = None
+        altitude_m = None
+
+        stn_info = getattr(engine, "stn_info", None)
+        if stn_info is not None:
+            latitude = getattr(stn_info, "latitude_f", None)
+            longitude = getattr(stn_info, "longitude_f", None)
+            alt = getattr(stn_info, "altitude", None)
+            try:
+                altitude_m = alt.meter.raw if alt is not None else None
+            except Exception:
+                altitude_m = None
+
+        station_cfg = config_dict.get("Station", {}) if config_dict else {}
+        if latitude is None:
+            try:
+                latitude = float(station_cfg.get("latitude"))
+            except Exception:
+                latitude = None
+        if longitude is None:
+            try:
+                longitude = float(station_cfg.get("longitude"))
+            except Exception:
+                longitude = None
+
+        if latitude is None or longitude is None:
+            return None
+
+        try:
+            return SkyfieldCalculator(latitude, longitude, altitude_m, ephemeris, cache_dir)
+        except Exception:
+            return None
