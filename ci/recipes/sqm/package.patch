+# 2026-10-22 weewx-packages: Install package files inside managed bin/user roots.
+# 2026-10-22 weewx-packages: Remove the installer local version label for WeeWX catalog compatibility; source SHA remains in package provenance.
+# 2026-10-22 weewx-packages: Install into the selected station, extend its SQM schema and defer device/ephemeris access to runtime.
+import os
+import socket
+import sys
+
+from setup import ExtensionInstaller
+
+
+def loader():
+    return SQM_Installer()
+
+
+def _prompt(text, default):
+    try:
+        value = input(f"{text} [{default}]: ").strip()
+    except EOFError:
+        return default
+    return value or default
+
+
+def _prompt_int(text, default):
+    while True:
+        value = _prompt(text, str(default))
+        try:
+            return int(value)
+        except ValueError:
+            print("Please enter a valid integer.")
+
+
+def _test_connection(host, port, timeout):
+    try:
+        with socket.create_connection((host, port), timeout=timeout) as sock:
+            sock.sendall(b"rx")
+            data = sock.recv(1024)
+        if data:
+            print("SQM-LE response:", data.decode("utf-8", errors="replace").strip())
+        else:
+            print("No data received from SQM-LE.")
+        return True
+    except Exception as exc:
+        print("SQM-LE connection test failed:", exc)
+        return False
+
+
+def _require_skyfield(ephemeris):
+    try:
+        cache_dir = "/var/lib/weewx/skyfield"
+        os.makedirs(cache_dir, exist_ok=True)
+        cwd = os.getcwd()
+        try:
+            os.chdir(cache_dir)
+            from skyfield.api import Loader
+        finally:
+            os.chdir(cwd)
+        load = Loader(cache_dir)
+        load(ephemeris)
+        return True
+    except Exception as exc:
+        print("Skyfield test failed:", exc)
+        return False
+
+
+def _get_existing_sqm_config(config):
+    sqm_cfg = config.get("SQM-LE", {})
+    host = sqm_cfg.get("host")
+    port = sqm_cfg.get("port")
+    poll_interval = sqm_cfg.get("poll_interval")
+    socket_timeout = sqm_cfg.get("socket_timeout")
+    max_samples = sqm_cfg.get("max_samples")
+    max_sample_age = sqm_cfg.get("max_sample_age")
+    ephemeris = sqm_cfg.get("ephemeris")
+    solar_alt_max = sqm_cfg.get("solar_alt_max")
+    return host, port, poll_interval, socket_timeout, max_samples, max_sample_age, ephemeris, solar_alt_max
+
+
+def _merge_data_services(config, service_name):
+    try:
+        services = config.get("Engine", {}).get("Services", {})
+        existing = services.get("data_services", "")
+    except Exception:
+        existing = ""
+
+    parts = [p.strip() for p in str(existing).split(",") if p.strip()]
+    if service_name not in parts:
+        parts.append(service_name)
+    return ", ".join(parts)
+
+
+def _load_config():
+    try:
+        from configobj import ConfigObj
+    except Exception as exc:
+        raise SystemExit(f"Aborting install: cannot load configobj: {exc}")
+
+    conf_path = "/etc/weewx/weewx.conf"
+    if not os.path.exists(conf_path):
+        raise SystemExit(f"Aborting install: missing config {conf_path}")
+    return ConfigObj(conf_path)
+
+
+def _get_db_info(config):
+    try:
+        binding = config["DataBindings"]["wx_binding"]
+        db_name = binding["database"]
+        table = binding.get("table_name", "archive")
+        db_cfg = config["Databases"][db_name]
+        db_type = db_cfg["database_type"]
+    except Exception as exc:
+        raise SystemExit(f"Aborting install: cannot read DB settings: {exc}")
+
+    return db_type, db_cfg, table, config
+
+
+def _ensure_sqlite_columns(db_path, table, columns):
+    import sqlite3
+
+    if not os.path.exists(db_path):
+        raise SystemExit(f"Aborting install: SQLite DB not found: {db_path}")
+
+    conn = sqlite3.connect(db_path)
+    try:
+        cur = conn.cursor()
+        cur.execute(f"PRAGMA table_info({table})")
+        existing = {row[1] for row in cur.fetchall()}
+        for name, decl in columns.items():
+            if name in existing:
+                continue
+            cur.execute(f"ALTER TABLE {table} ADD COLUMN {name} {decl}")
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def _ensure_mysql_columns(db_cfg, table, columns):
+    driver = None
+    try:
+        import MySQLdb as driver  # type: ignore
+    except Exception:
+        try:
+            import pymysql as driver  # type: ignore
+        except Exception:
+            driver = None
+
+    if driver is None:
+        raise SystemExit("Aborting install: MySQL driver not available (install mysqlclient or pymysql).")
+
+    host = db_cfg.get("host", "localhost")
+    user = db_cfg.get("user")
+    password = db_cfg.get("password", "")
+    database = db_cfg.get("database_name")
+    if not user or not database:
+        raise SystemExit("Aborting install: MySQL config missing user or database_name.")
+
+    conn = driver.connect(host=host, user=user, passwd=password, db=database)
+    try:
+        cur = conn.cursor()
+        cur.execute(f"SHOW COLUMNS FROM {table}")
+        existing = {row[0] for row in cur.fetchall()}
+        for name, decl in columns.items():
+            if name in existing:
+                continue
+            cur.execute(f"ALTER TABLE {table} ADD COLUMN {name} {decl}")
+        conn.commit()
+    finally:
+        conn.close()
+
