+            _inject_block(path, block_deep, anchor)
+        else:
+            _inject_block(path, block, anchor)
+
+    dataset_path = os.path.join(skin_root, "conditions_dataset.json.tmpl")
+    fields_old = (
+        "                \"barometer\"\n"
+        "            ],\n"
+    )
+    fields_new = (
+        "                \"barometer\",\n"
+        "                \"sqm\",\n"
